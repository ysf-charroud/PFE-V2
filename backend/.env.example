# Copy to .env and adjust as needed.

# Comma-separated origins are not parsed automatically; edit app/core/config.py
# defaults or set as JSON, e.g. CORS_ORIGINS=["http://localhost:5173"]

# Path to the fine-tuned model (defaults to ../model/cord_layoutlmv3)
# MODEL_DIR=C:\Code\PFE V2\model\cord_layoutlmv3

# Force CPU inference even if a GPU is available
FORCE_CPU=false

# Max upload size in MB
MAX_UPLOAD_MB=10

PORT=8000

# Comma-separated allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Max upload size in MB
MAX_UPLOAD_MB=10

# URL of the Python inference sidecar
INFERENCE_SIDECAR_URL=http://localhost:8001

# Directory where annotated images are saved (must match OUTPUT_DIR in the sidecar)
# OUTPUT_DIR=/absolute/path/to/backend/storage/annotated

SIDECAR_PORT=8001

# Where annotated images are saved (must match OUTPUT_DIR in the Express .env)
# OUTPUT_DIR=/absolute/path/to/backend/storage/annotated

# Absolute or relative path to the fine-tuned model directory
# MODEL_DIR=../../model/cord_layoutlmv3(v1)

# Force CPU even if CUDA is available
FORCE_CPU=false

# PaddleOCR language
OCR_LANG=en

# Minimum OCR confidence score to keep a word (0.0 – 1.0)
OCR_MIN_CONFIDENCE=0.5

# Upscale images whose long side is below this before OCR (px). Set 0 to disable.
OCR_UPSCALE_TO=1600

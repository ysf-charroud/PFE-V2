# Path to the fine-tuned Donut model directory.
# The loader auto-detects whether to use this path directly or its ./final
# subdirectory (the notebook saves under final/).
MODEL_DIR=../../model/donut-cord-finetuned

# Disable CUDA even when available
FORCE_CPU=false

# Donut task-start token (must match the value used at training time)
TASK_TOKEN=<s_cord-v2>

# Decoder max length — should match Cfg.MAX_LENGTH in the training notebook
MAX_LENGTH=768

# Use the slow XLMRoberta tokenizer. Set to false only if your env has
# protobuf>=3.20 AND a fast-tokenizer conversion path that works for Donut.
USE_SLOW_TOKENIZER=true
